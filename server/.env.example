# WeatherHub Server Environment Variables
# Copy this file to `.env` and fill in the values.

# Port the Express server listens on (defaults to 5000)
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/weatherhub?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWT tokens — use a long random string in production!
JWT_SECRET=

# JWT token expiry (defaults to 7d)
JWT_EXPIRE=7d

# OpenWeatherMap API key (optional — app falls back to mock data if not set)
# Get one free at https://openweathermap.org/api
WEATHER_API_KEY=

# Allowed CORS origin for the client
# In development: http://localhost:5173
# In production:  https://weather-hub-nine.vercel.app
CLIENT_URL=

# Set to 'production' in production environments
NODE_ENV=development

